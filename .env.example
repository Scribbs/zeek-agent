# Environment overrides for the Zeek summarizer stack
# Point these at your NemoClaw-managed vLLM instance

# Host path to Zeek logs (or NFS mount shared across the GB10 cluster)
ZEEK_LOG_DIR=/opt/zeek/logs

# NemoClaw / vLLM OpenAI-compatible endpoint
# Default assumes vLLM on the host at port 8000
VLLM_BASE_URL=http://host.docker.internal:8000/v1
# Or for the other node: http://192.168.x.x:8000/v1

# Model name registered by vLLM (check with curl $VLLM_BASE_URL/models)
VLLM_MODEL=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4

# Optional
VLLM_API_KEY=not-needed
REFRESH_SECONDS=60
LOG_WINDOW_MINUTES=15
