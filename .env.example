# Copy to .env and adjust for your cluster

# Cluster fabric IP of the head node (used by worker to join Ray)
HEAD_IP=10.0.0.1

# NCCL / GLOO interface (RoCE or eth)
NCCL_IF=eth0
NCCL_IB_DISABLE=0

# Hugging Face (required for gated models)
HF_TOKEN=

# vLLM
VLLM_PORT=8000
VLLM_MODEL=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4

# NemoClaw / OpenShell
NEMOCLAW_GATEWAY_PORT=9090
SANDBOX_NAME=OpenClaw

# Zeek analysis
ZEEK_LOG_DIR=/opt/zeek/logs
ZEEK_IFACE=eth0
VLLM_BASE_URL=http://host.docker.internal:8000/v1
VLLM_API_KEY=not-needed
REFRESH_SECONDS=60
LOG_WINDOW_MINUTES=15
